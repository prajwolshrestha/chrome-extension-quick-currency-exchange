{
  "manifest_version": 3,
  "name": "Quick Exchange Rate Converter",
  "version": "1.0",
  "description": "Popup currency converter with real-time exchange rates and support for selecting active currencies.",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://open.er-api.com/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}